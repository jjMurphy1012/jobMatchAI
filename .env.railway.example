# Railway environment variable reference.
# Do not commit real secrets.

# Backend service
DATABASE_URL=postgresql+asyncpg://...
JWT_SECRET_KEY=replace-with-long-random-secret
OPENAI_API_KEY=sk-your-openai-api-key
APP_NAME=Job Matching AI
DEBUG=false

FRONTEND_URL=https://your-frontend.up.railway.app
BACKEND_CORS_ORIGINS=https://your-frontend.up.railway.app

AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
ADMIN_EMAILS=admin@example.com

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-frontend.up.railway.app/api/auth/google/callback

STORAGE_BACKEND=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_RESUME_BUCKET=resumes

MATCH_THRESHOLD=70
MIN_THRESHOLD=30
THRESHOLD_STEP=5
TARGET_JOBS=10
MATCH_LLM_RERANK_LIMIT=20
MATCH_LLM_BATCH_SIZE=10

EMAIL_NOTIFICATIONS_ENABLED=false
SENDGRID_API_KEY=SG.your-sendgrid-key
SENDGRID_FROM_EMAIL=notifications@your-domain.com
SENDGRID_FROM_NAME=JobMatchAI

ENABLE_SCHEDULER=false
PUSH_HOUR=7
PUSH_MINUTE=0
TIMEZONE=America/New_York

# Frontend service
BACKEND_URL=https://your-backend.up.railway.app
